<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionString>
		<add name="BikeStore" connectionString="Data Source=(localdb)\MSSQLLocalDB;
			 Initial Catalog=ContactI;Integrated Security=True;Pooling=False;Encrypt=True;
			 TrustServerCertificate=False;Encrypt=False; 
			 AttachDbFilename=|DataDirectory|\BikeStore.mdf;" />
	</connectionString>
	
</configuration>